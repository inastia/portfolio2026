{
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/corporate-gossip",
      "destination": "/src/projects/corporate-gossip.html"
    },
    {
      "source": "/travel-guide",
      "destination": "/src/projects/travel-guide.html"
    },

    {
      "source": "/camelot-vet",
      "destination": "/src/projects/camelot-vet.html"
    },
    { "source": "/chani", "destination": "/src/projects/chani.html" },

    { "source": "/", "destination": "/index.html" },
    { "source": "/about", "destination": "/about.html" },
    { "source": "/resources", "destination": "/resources.html" },

    { "source": "/projects/:name", "destination": "/projects/:name" }
  ]
}
